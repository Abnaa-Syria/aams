  // English fields (for reference)
  labelEn        String?    @db.VarChar(200)
  descriptionEn  String?    @db.VarChar(500)
  
  // Configuration
  type           String     @default("text") @db.VarChar(20) // text, boolean, number, select, json
  options        String?    @db.Text // JSON array for select options: [{"value": "opt1", "label": "Option 1"}]
  category       String?    @db.VarChar(50) // general, security, notifications, etc.
  group          String?    @db.VarChar(50) // deprecated, use category
  sortOrder      Int        @default(0)
  isVisible      Boolean    @default(true)
  isEditable     Boolean    @default(true)
  
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

