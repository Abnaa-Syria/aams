// ADMIN REQUESTS (طلبات إدارية)
// ============================================================

model AdminRequest {
  id            Int              @id @default(autoincrement())
  userId        Int
  user          User             @relation(fields: [userId], references: [id])
  type          AdminRequestType
  title         String           @db.VarChar(300)
  details       String           @db.Text
  attachmentUrl String?          @db.VarChar(500)
  attachmentName String?         @db.VarChar(255)
  status        RequestStatus    @default(PENDING)
  reviewedBy    Int?
  reviewedAt    DateTime?
  reviewNotes   String?          @db.Text
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("admin_requests")
}

// ============================================================
// LICENSE TESTS (اختبار الرخصة)
// ============================================================

model LicenseTest {
  id                Int               @id @default(autoincrement())
  userId            Int
  user              User              @relation(fields: [userId], references: [id])
  testDate          DateTime?
  result            LicenseTestResult?
  isRetest          Boolean           @default(false)
  previousTestId    Int?
  notes             String?           @db.Text
  scheduledBy       Int?
  resultSetBy       Int?
  resultSetAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([result])
  @@map("license_tests")
}

// ============================================================
// CANCELED ORDER LOGS (طلبات ملغاة)
// ============================================================

model CanceledOrderLog {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  orderRef      String?   @db.VarChar(100)
  reason        String    @db.Text
  invoiceUrl    String?   @db.VarChar(500)
  photoUrl      String?   @db.VarChar(500)
  discountAmount Decimal? @db.Decimal(10, 2)
  platformName  String?   @db.VarChar(100)
  orderDate     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([orderDate])
  @@map("canceled_order_logs")
}

// ============================================================
// TRAINEE TRACKING (المتدربون)
// ============================================================

model Trainee {
  id              Int       @id @default(autoincrement())
  traineeId       Int
  trainee         User      @relation("TraineeUser", fields: [traineeId], references: [id])
  trainerId       Int
  trainer         User      @relation("TrainerUser", fields: [trainerId], references: [id])
  startDate       DateTime
  endDate         DateTime?
  totalDays       Int       @default(30)
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  rewardIssued    Boolean   @default(false)
  rewardAmount    Decimal?  @db.Decimal(10, 2)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([traineeId])
  @@index([trainerId])
  @@index([isCompleted])
  @@map("trainees")
}

// ============================================================
// SUBSTITUTE VEHICLE ASSIGNMENT (مركبة بديلة)
// ============================================================

model SubstituteVehicleAssignment {
  id              Int       @id @default(autoincrement())
  vehicleId       Int
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id])
  originalVehicleId Int?
  userId          Int?
  startDate       DateTime
  endDate         DateTime?
  reason          String?   @db.Text
  isActive        Boolean   @default(true)
  assignedBy      Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([vehicleId])
  @@index([isActive])
  @@map("substitute_vehicle_assignments")
}

// ============================================================
// OIL CHANGE LOGS (سجل تغيير الزيت)
// ============================================================

model OilChangeLog {
  id              Int       @id @default(autoincrement())
  vehicleId       Int
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id])
  odometerAtChange Int
  changeDate      DateTime  @default(now())
  nextDueOdometer Int?
  maintenanceReqId Int?
  notes           String?   @db.Text
  performedBy     Int?
  createdAt       DateTime  @default(now())

  @@index([vehicleId])
  @@map("oil_change_logs")
}

// ============================================================
// VEHICLE SWAP REQUESTS (طلب تبديل مركبة)
// ============================================================

model VehicleSwapRequest {
  id              Int               @id @default(autoincrement())
  shiftId         Int
  shift           Shift             @relation(fields: [shiftId], references: [id])
  userId          Int
  user            User              @relation(fields: [userId], references: [id])
  currentVehicleId Int
  currentVehicle  Vehicle           @relation(fields: [currentVehicleId], references: [id])
  reason          String            @db.Text
  status          VehicleSwapStatus @default(REQUESTED)
  newVehicleId    Int?
  reviewedBy      Int?
  reviewedAt      DateTime?
  reviewNotes     String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([shiftId])
  @@index([userId])
  @@index([status])
  @@map("vehicle_swap_requests")
}

// ============================================================
// SCHEDULED REMINDERS (تنبيهات مواعيد)
// ============================================================

model ScheduledReminder {
  id            Int       @id @default(autoincrement())
  targetUserId  Int
  targetUser    User      @relation("ReminderTarget", fields: [targetUserId], references: [id])
  createdById   Int
  createdBy     User      @relation("ReminderCreator", fields: [createdById], references: [id])
  title         String    @db.VarChar(300)
  body          String    @db.Text
  triggerDate   DateTime
  isSent        Boolean   @default(false)
  sentAt        DateTime?
  category      String?   @db.VarChar(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([targetUserId])
  @@index([triggerDate])
  @@index([isSent])
  @@map("scheduled_reminders")
}
