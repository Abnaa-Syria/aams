generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  OPERATIONS_ADMIN
  HR_ADMIN
  FLEET_ADMIN
  FINANCE_ADMIN
  // DEPRECATED: DRIVER and SUPERVISOR roles moved to AppUserRole
  // These are kept temporarily during migration for backward compatibility
  // After migration phase, update these users to OPERATIONS_ADMIN and create AppUser records
  SUPERVISOR
  DRIVER
}

// AppUserRole - operational/mobile app roles (linked to AppUser)
enum AppUserRole {
  DRIVER
  SUPERVISOR
}

enum AccountStatus {
  ACTIVE
  TEMPORARILY_SUSPENDED
  RESTRICTED
  UNDER_INVESTIGATION
  PENDING_APPROVAL
  INCOMPLETE_PROFILE
  ARCHIVED
}

enum AvailabilityStatus {
  AVAILABLE
  ON_SHIFT
  ON_LEAVE
  OFF_DUTY
}

enum Gender {
  MALE
  FEMALE
}

enum DocumentType {
  NATIONAL_ID
  IQAMA
  PASSPORT
  WORK_CONTRACT
  RESIDENCE_PERMIT
  BORDER_NUMBER
  MUQEEM_ID
  VISA
  CONTRACT_WITH_SANAD
  DRIVER_CARD
  DRIVING_PERMIT
  POLICE_CLEARANCE
  WORK_INJURY
  CLEARANCE_DOC
  TERMINATION_DOC
  HEALTH_CARD
  MEDICAL_INSURANCE
  OTHER
}

enum DocumentStatus {
  VALID
  NEAR_EXPIRY
  EXPIRED
  UNDER_REVIEW
  REJECTED
  PENDING
}

enum LicenseType {
  DRIVING_LICENSE
  TRANSPORT_LICENSE
  MEDICAL_CERTIFICATE
  OTHER_CERTIFICATE
}

enum VehicleStatus {
  ACTIVE
  IN_MAINTENANCE
  OUT_OF_SERVICE
  RESERVED
  DECOMMISSIONED
}

enum OwnershipStatus {
  COMPANY_OWNED
  DRIVER_OWNED
  LEASED
  RENTED
}

enum ShiftStatus {
  REQUESTED
  APPROVED
  REJECTED
  ACTIVE
  ENDED
  CANCELLED
}

enum FuelLogStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum ViolationStatus {
  REPORTED
  UNDER_REVIEW
  CONFIRMED
  DISMISSED
  PENALIZED
}

enum IncidentType {
  MEDICAL
  ACCIDENT
  BREAKDOWN
  LARGE_ORDER
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum InvestigationStatus {
  OPEN
  PENDING_RESPONSE
  UNDER_REVIEW
  CLOSED
}

enum PenaltyType {
  FINANCIAL
  WARNING
  SUSPENSION
  TERMINATION
  ASSET_DAMAGE
  MISCONDUCT
  OTHER
}

enum PenaltyStatus {
  PENDING
  APPLIED
  APPEALED
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  UNPAID
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  REQUESTED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BankVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PlatformAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum NotificationCategory {
  SYSTEM
  SHIFT
  DOCUMENT
  COMPLIANCE
  APPROVAL
  ALERT
  HR
  GENERAL
}

enum PushProvider {
  EXPO
  FCM_LEGACY
  WEB_PUSH
  CUSTOM
}

enum OdometerLogType {
  START_SHIFT
  END_SHIFT
  MAINTENANCE
  FUEL
}

enum PayrollStatus {
  OPEN
  PROCESSING
  COMPLETED
  ARCHIVED
}

enum EmploymentStatus {
  ON_DUTY
  ON_LEAVE
  SUSPENDED
  RUNAWAY
  FINAL_EXIT
}

enum TransportType {
  CAR
  MOTORCYCLE
  TRUCK
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
}

enum CashReceivedStatus {
  RECEIVED
  NOT_RECEIVED
}

enum AdminRequestType {
  BONUS
  REVIEW
  EXEMPTION
  OBJECTION
  VEHICLE_TRANSFER
  SHIFT_TRANSFER
  GOVERNMENT_ACTION
  ASSET_RECEIPT
  OTHER
}

enum LicenseTestResult {
  ADVANCED
  INTERMEDIATE
  BEGINNER
  FAIL
}

enum ComplaintType {
  SUPERVISOR_COMPLAINT
  EMPLOYEE_COMPLAINT
}

enum AssetType {
  MOTORCYCLE
  SAFETY_EQUIPMENT
  PHONE
  SIM_CARD
  LICENSE_CARD
  THERMAL_BOX
  OTHER
}

enum AssetStatus {
  ASSIGNED
  RETURNED
  DAMAGED
  LOST
}

enum BreakStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum VehicleSwapStatus {
  REQUESTED
  APPROVED
  REJECTED
}

// ============================================================
// USERS (Drivers, Admins, Supervisors)
// ============================================================

model User {
  id                Int               @id @default(autoincrement())
  identityNumber    String            @unique @db.VarChar(20)
  mobileNumber      String?           @unique @db.VarChar(20)
  email             String?           @db.VarChar(100)
  passwordHash      String            @db.VarChar(255)
  fullNameAr        String            @db.VarChar(150)
  fullNameEn        String?           @db.VarChar(150)
  gender            Gender?
  dateOfBirth       DateTime?
  nationality       String?           @db.VarChar(80)
  profileImageUrl   String?           @db.VarChar(500)
  role              UserRole          @default(OPERATIONS_ADMIN)
  accountStatus     AccountStatus     @default(PENDING_APPROVAL)

  // TEMPORARY: Operational fields kept during migration - will be removed in cleanup phase
  // These fields are mirrored in AppUser for DRIVER/SUPERVISOR users
  availabilityStatus AvailabilityStatus @default(OFF_DUTY)
  employmentStatus  EmploymentStatus  @default(ON_DUTY)
  transportType     TransportType?
  sevenHundredNumber String?          @db.VarChar(50)
  roomNumber        String?           @db.VarChar(50)
  tags              String?           @db.VarChar(500)
  notes             String?           @db.Text
  supervisorId      Int?

  // Emergency contact (جهة اتصال الطوارئ)
  emergencyName     String?           @db.VarChar(150)
  emergencyRelation String?           @db.VarChar(100)
  emergencyPhone    String?           @db.VarChar(20)

  // Employment info (for admin/platform users)
  employeeNumber    String?           @unique @db.VarChar(50)
  joinDate          DateTime?
  contractEndDate   DateTime?
  jobTitle          String?           @db.VarChar(100)

  // Location
  cityId            Int?
  regionId          Int?
  branchId          Int?
  city              City?             @relation(fields: [cityId], references: [id])

  // OTP
  otpCode           String?           @db.VarChar(10)
  otpExpiresAt      DateTime?

  // Timestamps
  lastLoginAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  // RBAC-only relations (admin operations)
  loginActivities   LoginActivity[]
  refreshTokens     RefreshToken[]
  createdInvestigations Investigation[] @relation("InvestigationCreator")
  givenRatings      Rating[]          @relation("Rater")
  assignedTickets   Ticket[]          @relation("AssignedTickets")
  createdReminders  ScheduledReminder[]  @relation("ReminderCreator")

  // 1:1 relation to AppUser (only for DRIVER/SUPERVISOR operational users)
  appUser           AppUser?

  // TEMPORARY: Operational relations kept for backward compatibility during migration
  // These will be migrated to AppUser incrementally - do NOT use in new code
  documents         Document[]
  licenses          License[]
  bankAccounts      BankAccount[]
  platformAccounts  PlatformAccount[]
  vehicleAssignment VehicleAssignment[]
  shifts            Shift[]
  fuelLogs          FuelLog[]
  violations        Violation[]
  incidents         Incident[]
  dailyReports      DailyReport[]
  notifications     Notification[]
  sentMessages      ChatMessage[]     @relation("SentMessages")
  receivedMessages  ChatMessage[]     @relation("ReceivedMessages")
  investigations    Investigation[]   @relation("InvestigatedUser")
  penalties         Penalty[]
  ratings           Rating[]          @relation("RatedUser")
  rewards           Reward[]
  leaveRequests     LeaveRequest[]
  salaryAdvances    SalaryAdvance[]
  maintenanceReqs   MaintenanceRequest[]
  auditLogs         AuditLog[]
  tickets           Ticket[]          @relation("UserTickets")
  ticketMessages    TicketMessage[]
  leaveBalances     LeaveBalance[]
  pushDeviceTokens  PushDeviceToken[]
  odometerLogs      VehicleOdometerLog[]
  payrolls          EmployeePayroll[]
  assetAssignments  AssetAssignment[]
  breakRequests     BreakRequest[]
  complaints        Complaint[]       @relation("ComplaintSubject")
  filedComplaints   Complaint[]       @relation("ComplaintFiler")
  adminRequests     AdminRequest[]
  licenseTests      LicenseTest[]
  canceledOrders    CanceledOrderLog[]
  traineeRecords    Trainee[]         @relation("TraineeUser")
  trainerRecords    Trainee[]         @relation("TrainerUser")
  vehicleSwapReqs   VehicleSwapRequest[]
  scheduledReminders ScheduledReminder[] @relation("ReminderTarget")
  locationHistory   LocationHistory[]

  @@index([accountStatus])
  @@index([role])
  @@index([cityId])
  @@map("users")
}

// AppUser - operational/mobile app users (DRIVER, SUPERVISOR)
// Linked 1:1 to User for RBAC, contains operational data only
// Relations to operational models (Shift, FuelLog, etc.) are defined on those models via appUserId
model AppUser {
  id                  Int               @id @default(autoincrement())
  userId              Int               @unique
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // App role - operational role only
  appRole             AppUserRole       @default(DRIVER)

  // Operational fields (moved from User)
  availabilityStatus  AvailabilityStatus @default(OFF_DUTY)
  employmentStatus    EmploymentStatus  @default(ON_DUTY)
  transportType       TransportType?

  // Supervisor hierarchy (moved from User.supervisorId)
  supervisorId        Int?
  supervisor          AppUser?          @relation("SupervisorAppUsers", fields: [supervisorId], references: [id])
  assignedDrivers     AppUser[]         @relation("SupervisorAppUsers")

  // Additional operational fields (moved from User)
  sevenHundredNumber  String?           @db.VarChar(50)
  roomNumber          String?           @db.VarChar(50)
  tags                String?           @db.VarChar(500)
  notes               String?           @db.Text

  // Timestamps
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relations to operational models via appUserId
  shifts              Shift[]
  fuelLogs            FuelLog[]
  incidents           Incident[]
  dailyReports        DailyReport[]
  violations          Violation[]
  penalties           Penalty[]
  rewards             Reward[]
  leaveRequests       LeaveRequest[]
  salaryAdvances      SalaryAdvance[]
  maintenanceReqs     MaintenanceRequest[]

  @@index([userId])
  @@index([appRole])
  @@index([supervisorId])
  @@map("app_users")
}

model PushDeviceToken {
  id        Int          @id @default(autoincrement())
  userId    Int
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String       @unique @db.VarChar(512)
  provider  PushProvider @default(EXPO)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@map("push_device_tokens")
}

model LoginActivity {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  ipAddress   String?   @db.VarChar(50)
  userAgent   String?   @db.VarChar(500)
  loginAt     DateTime  @default(now())
  success     Boolean   @default(true)

  @@index([userId])
  @@map("login_activities")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique @db.VarChar(512)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================
// LOCATION MASTER DATA
// ============================================================

model City {
  id          Int       @id @default(autoincrement())
  nameAr      String    @db.VarChar(100)
  nameEn      String?   @db.VarChar(100)
  region      String?   @db.VarChar(100)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  users       User[]

  @@map("cities")
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id              Int             @id @default(autoincrement())
  userId          Int
  user            User            @relation(fields: [userId], references: [id])
  type            DocumentType
  title           String          @db.VarChar(200)
  documentNumber  String?         @db.VarChar(100)
  issueDate       DateTime?
  expiryDate      DateTime?
  status          DocumentStatus  @default(PENDING)
  fileUrl         String?         @db.VarChar(500)
  fileName        String?         @db.VarChar(255)
  reviewedBy      Int?
  reviewedAt      DateTime?
  reviewNotes     String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([expiryDate])
  @@map("documents")
}

// ============================================================
// LICENSES & CERTIFICATES
// ============================================================

model License {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  type            LicenseType
  licenseNumber   String?       @db.VarChar(100)
  title           String        @db.VarChar(200)
  issueDate       DateTime?
  expiryDate      DateTime?
  status          DocumentStatus @default(PENDING)
  fileUrl         String?       @db.VarChar(500)
  fileName        String?       @db.VarChar(255)
  reviewedBy      Int?
  reviewedAt      DateTime?
  reviewNotes     String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([expiryDate])
  @@map("licenses")
}

// ============================================================
// BANK ACCOUNTS
// ============================================================

model BankAccount {
  id                  Int                   @id @default(autoincrement())
  userId              Int
  user                User                  @relation(fields: [userId], references: [id])
  bankName            String                @db.VarChar(150)
  iban                String                @db.VarChar(50)
  accountOwnerName    String                @db.VarChar(200)
  isDefault           Boolean               @default(false)
  verificationStatus  BankVerificationStatus @default(PENDING)
  proofFileUrl        String?               @db.VarChar(500)
  proofFileName       String?               @db.VarChar(255)
  paymentMethod       PaymentMethod         @default(BANK_TRANSFER)
  cashReceiptPhotoUrl String?               @db.VarChar(500)
  receivedStatus      CashReceivedStatus?
  receivedDate        DateTime?
  reviewedBy          Int?
  reviewedAt          DateTime?
  reviewNotes         String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?

  @@index([userId])
  @@index([paymentMethod])
  @@map("bank_accounts")
}

// ============================================================
// DELIVERY PLATFORMS
// ============================================================

model Platform {
  id          Int               @id @default(autoincrement())
  nameAr      String            @db.VarChar(100)
  nameEn      String?           @db.VarChar(100)
  logoUrl     String?           @db.VarChar(500)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  accounts    PlatformAccount[]

  @@map("platforms")
}

model PlatformAccount {
  id              Int                   @id @default(autoincrement())
  userId          Int
  user            User                  @relation(fields: [userId], references: [id])
  platformId      Int
  platform        Platform              @relation(fields: [platformId], references: [id])
  username        String?               @db.VarChar(150)
  accountId       String?               @db.VarChar(150)
  status          PlatformAccountStatus @default(PENDING_VERIFICATION)
  notes           String?               @db.Text
  fileUrl         String?               @db.VarChar(500)
  accountScreenshotUrl String?          @db.VarChar(500)
  isAlternate     Boolean               @default(false)
  alternateUsername String?             @db.VarChar(150)
  receiptDate     DateTime?
  returnDate      DateTime?
  startWorkDate   DateTime?
  verifiedBy      Int?
  verifiedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?
  shifts          Shift[]

  @@index([userId])
  @@index([platformId])
  @@index([username])
  @@map("platform_accounts")
}

// ============================================================
// VEHICLES
// ============================================================

model Vehicle {
  id                  Int               @id @default(autoincrement())
  plateNumber         String            @unique @db.VarChar(20)
  manufacturer        String?           @db.VarChar(100)
  model               String?           @db.VarChar(100)
  year                Int?
  color               String?           @db.VarChar(50)
  odometerKm          Int?
  status              VehicleStatus     @default(ACTIVE)
  ownershipStatus     OwnershipStatus   @default(COMPANY_OWNED)

  // Insurance
  insuranceCompany    String?           @db.VarChar(150)
  insurancePolicyNo   String?           @db.VarChar(100)
  insuranceStartDate  DateTime?
  insuranceExpiryDate DateTime?

  // Registration (Istimara)
  registrationNumber  String?           @db.VarChar(100)
  registrationExpiry  DateTime?
  registrationFileUrl String?           @db.VarChar(500)
  
  tankCapacity        Int?              // in liters
  fuelType            String?           @db.VarChar(50)  // 91, 95, Diesel
  
  notes               String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  assignments         VehicleAssignment[]
  shifts              Shift[]
  fuelLogs            FuelLog[]
  violations          Violation[]
  maintenanceReqs     MaintenanceRequest[]
  odometerLogs        VehicleOdometerLog[]
  substituteAssigns   SubstituteVehicleAssignment[]
  oilChangeLogs       OilChangeLog[]
  vehicleSwapReqs     VehicleSwapRequest[]

  @@index([status])
  @@index([plateNumber])
  @@map("vehicles")
}

model VehicleAssignment {
  id          Int       @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  assignedAt  DateTime  @default(now())
  releasedAt  DateTime?
  isActive    Boolean   @default(true)
  notes       String?   @db.Text

  @@index([vehicleId])
  @@index([userId])
  @@map("vehicle_assignments")
}

model VehicleOdometerLog {
  id        Int             @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id])
  userId    Int
  user      User            @relation(fields: [userId], references: [id])
  shiftId   Int?
  shift     Shift?          @relation(fields: [shiftId], references: [id])
  reading   Int
  photoUrl  String?         @db.VarChar(500)
  type      OdometerLogType
  createdAt DateTime        @default(now())

  @@index([vehicleId])
  @@index([userId])
  @@map("vehicle_odometer_logs")
}

// ============================================================
// SHIFTS
// ============================================================

model Shift {
  id                Int           @id @default(autoincrement())
  
  // TEMPORARY: userId kept for backward compatibility during migration
  userId            Int
  user              User          @relation(fields: [userId], references: [id])
  
  // NEW: appUserId for operational queries (to replace userId)
  appUserId         Int?
  appUser           AppUser?      @relation(fields: [appUserId], references: [id])
  
  vehicleId         Int
  vehicle           Vehicle       @relation(fields: [vehicleId], references: [id])
  platformAccountId Int
  platformAccount   PlatformAccount @relation(fields: [platformAccountId], references: [id])
  status            ShiftStatus   @default(REQUESTED)

  requestedAt       DateTime      @default(now())
  approvedAt        DateTime?
  approvedBy        Int?
  rejectedAt        DateTime?
  rejectedBy        Int?
  rejectionReason   String?       @db.Text
  startedAt         DateTime?
  endedAt           DateTime?
  cancelledAt       DateTime?
  cancellationReason String?      @db.Text
  
  requestedStartTime DateTime?
  requestedEndTime   DateTime?

  startPhotoUrl     String?       @db.VarChar(500)
  startOdometer     Int?
  startVehiclePhotoUrl String?    @db.VarChar(500)
  startAppPhotoUrl  String?       @db.VarChar(500)
  endPhotoUrl       String?       @db.VarChar(500)
  endOdometer       Int?
  endAppPhotoUrl    String?       @db.VarChar(500)
  notes             String?       @db.Text

  // Real-time tracking — latest known position (التتبع اللحظي)
  lastLat           Float?
  lastLng           Float?
  lastLocationAt    DateTime?

  // Shift closure request (طلب إقفال شفت)
  closureRequested  Boolean       @default(false)
  closureApprovedBy Int?
  closureApprovedAt DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  midShiftRecords   MidShiftRecord[]
  fuelLogs          FuelLog[]
  violations        Violation[]
  incidents         Incident[]
  dailyReports      DailyReport[]
  shiftLogs         ShiftLog[]
  odometerLogs      VehicleOdometerLog[]
  breakRequests     BreakRequest[]
  vehicleSwapReqs   VehicleSwapRequest[]

  @@index([userId])
  @@index([status])
  @@index([requestedAt])
  @@map("shifts")
}

model ShiftLog {
  id        Int       @id @default(autoincrement())
  shiftId   Int
  shift     Shift     @relation(fields: [shiftId], references: [id])
  action    String    @db.VarChar(100)
  performedBy Int?
  notes     String?   @db.Text
  createdAt DateTime  @default(now())

  @@index([shiftId])
  @@map("shift_logs")
}

model MidShiftRecord {
  id              Int       @id @default(autoincrement())
  shiftId         Int
  shift           Shift     @relation(fields: [shiftId], references: [id])
  screenshotUrl   String?   @db.VarChar(500)
  checklistData   Json?
  notes           String?   @db.Text
  recordedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([shiftId])
  @@map("mid_shift_records")
}

// ============================================================
// FUEL LOGS
// ============================================================

model FuelLog {
  id            Int           @id @default(autoincrement())
  
  // TEMPORARY: userId kept for backward compatibility during migration
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  
  // NEW: appUserId for operational queries
  appUserId     Int?
  appUser       AppUser?      @relation(fields: [appUserId], references: [id])
  
  vehicleId     Int
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])
  shiftId       Int?
  shift         Shift?        @relation(fields: [shiftId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  liters        Decimal?      @db.Decimal(10, 2)
  fuelDate      DateTime
  receiptUrl    String?       @db.VarChar(500)
  status        FuelLogStatus @default(PENDING)
  reviewedBy    Int?
  reviewedAt    DateTime?
  reviewNotes   String?       @db.Text
  isDuplicate   Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([appUserId])
  @@index([vehicleId])
  @@index([shiftId])
  @@index([fuelDate])
  @@map("fuel_logs")
}

// ============================================================
// VIOLATIONS
// ============================================================

model Violation {
  id              Int             @id @default(autoincrement())
  
  // TEMPORARY: userId kept for backward compatibility during migration
  userId          Int
  user            User            @relation(fields: [userId], references: [id])
  
  // NEW: appUserId for operational queries
  appUserId       Int?
  appUser         AppUser?        @relation(fields: [appUserId], references: [id])
  
  vehicleId       Int?
  vehicle         Vehicle?        @relation(fields: [vehicleId], references: [id])
  shiftId         Int?
  shift           Shift?          @relation(fields: [shiftId], references: [id])
  amount          Decimal?        @db.Decimal(10, 2)
  reason          String          @db.Text
  location        String?         @db.VarChar(300)
  driverComment   String?         @db.Text
  violationDate   DateTime?
