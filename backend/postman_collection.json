	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.request.headers.add({",
					"    key: \"Authorization\",",
					"    value: \"Bearer \" + pm.collectionVariables.get(\"access_token\")",
					"});"
				]
			}
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login (Mobile OTP)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"mobileNumber\": \"0501234567\",\n    \"otp\": \"123456\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/auth/login-mobile",
							"host": ["{{base_url}}"],
							"path": ["auth", "login-mobile"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"",
									"if (res.data && res.data.accessToken) {",
									"    pm.collectionVariables.set(\"access_token\", res.data.accessToken);",
									"    pm.collectionVariables.set(\"refresh_token\", res.data.refreshToken);",
									"    pm.collectionVariables.set(\"user_id\", res.data.user.id.toString());",
									"    if (res.data.user.appUser && res.data.user.appUser.id) pm.collectionVariables.set(\"app_user_id\", res.data.user.appUser.id.toString());",
									"    console.log(\"✅ Tokens saved successfully\");",
									"} else {",
									"    console.log(\"❌ Login failed - check response\", res);",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Send OTP",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"mobileNumber\": \"0501234567\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/auth/send-otp",
							"host": ["{{base_url}}"],
							"path": ["auth", "send-otp"]
						}
					}
				},
				{
