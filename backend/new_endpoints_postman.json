	"item": [
		{
			"name": "Daily Reports",
			"item": [
				{
					"name": "Report Details",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/daily-reports/:id",
							"host": ["{{base_url}}"],
							"path": ["daily-reports", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "1"
								}
							]
						}
					}
				}
			]
		},
