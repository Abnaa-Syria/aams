		{
			"name": "Auth",
			"item": [
				{
					"name": "Delete My Account (Soft Delete)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"description": "Soft deletes the authenticated driver account: sets accountStatus to ARCHIVED, sets deletedAt, and revokes refresh/push tokens.",
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": ["{{base_url}}"],
							"path": ["auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "Bank Accounts",
			"item": [
				{
					"name": "Delete My Bank Account",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{access_token}}"
							}
						],
						"description": "Driver-scoped soft delete. A driver can delete only their own bank account. Admin users with finance write permission can delete any bank account.",
						"url": {
							"raw": "{{base_url}}/bank-accounts/:id",
							"host": ["{{base_url}}"],
							"path": ["bank-accounts", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "1"
								}
							]
						}
					}
				}
			]
		},
