# Server
NODE_ENV=development
PORT=5000
# Comma-separated for multiple frontends, e.g. http://localhost:5173,http://localhost:5174
# In development, 5173 and 5174 are allowed by default even if you omit this.
CORS_ORIGIN=http://localhost:5173

# Database (MySQL / MariaDB)
DATABASE_URL="mysql://user:password@localhost:3306/aams"

# JWT
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Uploads (local disk)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Optional: S3-compatible storage (MinIO, AWS S3, etc.)
# STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_REGION=us-east-1
# S3_BUCKET=aams-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=http://localhost:9000/aams-uploads
# S3_KEY_PREFIX=uploads

# Push notifications (optional; in-app DB notifications always work)
# EXPO_ACCESS_TOKEN=
# FCM_LEGACY_SERVER_KEY=
