# Server
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=mysql://user:password@localhost:3306/aams

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated in production)
CORS_ORIGIN=http://localhost:5173

# Uploads (local until Phase 10 S3)
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
STORAGE_DRIVER=local

# S3 / MinIO (Phase 10 — integrations)
# STORAGE_DRIVER=s3
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=
# S3_KEY_PREFIX=uploads

# OTP (disable STATIC_OTP in production — Phase 10)
OTP_EXPIRY_MINUTES=5
# STATIC_OTP=

# Push (Phase 10 — integrations)
# EXPO_ACCESS_TOKEN=
# FCM_LEGACY_SERVER_KEY=

# Redis (Phase 10 — integrations)
# REDIS_URL=redis://localhost:6379
